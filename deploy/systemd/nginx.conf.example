# Replace reader.example.com with the exact published HTTPS hostname.
worker_processes 1;
pid /var/lib/x-reader-proxy/nginx.pid;
error_log stderr warn;
events { worker_connections 128; }
http {
    access_log off;
    server_tokens off;
    client_body_temp_path /var/lib/x-reader-proxy/body;
    proxy_temp_path /var/lib/x-reader-proxy/proxy;
    fastcgi_temp_path /var/lib/x-reader-proxy/fastcgi;
    uwsgi_temp_path /var/lib/x-reader-proxy/uwsgi;
    scgi_temp_path /var/lib/x-reader-proxy/scgi;
    limit_req_zone $binary_remote_addr zone=pairing:1m rate=5r/m;
    server {
        listen 8403;
        server_name reader.example.com;
        if ($host != reader.example.com) { return 403; }
        client_max_body_size 1k;
        client_body_timeout 10s;
        location = /api/pair {
            limit_req zone=pairing burst=3 nodelay;
            proxy_pass http://127.0.0.1:4043;
            include /etc/x-reader-proxy/upstream.conf;
        }
        location / {
            proxy_pass http://127.0.0.1:4043;
            include /etc/x-reader-proxy/upstream.conf;
        }
    }
}
