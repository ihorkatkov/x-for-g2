# Backend credentials only. Never use VITE_ prefixes for these values.
REED_MODE=live
AUTH_TOKEN=
CT0=

# For a packaged glasses build: your own Tailscale HTTPS origin (not a secret).
# X_SERVICE_ORIGIN=https://your-laptop.your-tailnet.ts.net:8449
# REED_TAILSCALE_USER=your-tailscale-login@example.com
# Optional separate session file; no external skill or config is read by default.
# REED_SESSION_ENV=/absolute/path/to/your/private/session.env
# REED_PAIRING_FILE=/absolute/path/to/device-session-hashes.json

# Optional listener overrides: local server defaults to4040; beta server to4043.
# REED_HOST=127.0.0.1
# REED_PORT=4043
# REED_ORIGIN defaults to X_SERVICE_ORIGIN in the beta launcher.
# REED_ORIGIN=https://your-laptop.your-tailnet.ts.net:8449

# Advanced: paired public query IDs if discovery breaks. Never guessed.
# REED_HOME_QUERY_ID=
# REED_LATEST_QUERY_ID=
# REED_QUERY_FORMAT=relay
